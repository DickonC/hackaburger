  <!-- ========================================== -->
  <!-- INTERACTION LOGIC & CHARTS                 -->
  <!-- ========================================== -->
  <script>
    let currentView = 'consumer';
    let currentZone = 'uno-q-1';
    let configVersion = 3;
    let consumerChart = null;
    let adminChart = null;

    // View Switcher: Consumer vs Admin Console
    function switchView(view) {
      currentView = view;
      const consumerEl = document.getElementById('consumerView');
      const adminEl = document.getElementById('adminView');
      const body = document.body;
      const header = document.getElementById('mainHeader');
      const footer = document.getElementById('mainFooter');
      const footerText = document.getElementById('footerText');
      const brandLogo = document.getElementById('brandLogo');
      const brandTitle = document.getElementById('brandTitle');
      const brandSubtitle = document.getElementById('brandSubtitle');
      const btnViewConsumer = document.getElementById('btnViewConsumer');
      const btnViewAdmin = document.getElementById('btnViewAdmin');

      if (view === 'consumer') {
        consumerEl.classList.remove('hidden');
        adminEl.classList.add('hidden');
        
        body.className = 'bg-slate-50 text-slate-800 transition-colors duration-300 min-h-screen flex flex-col';
        header.className = 'sticky top-0 z-50 backdrop-blur-md border-b bg-white/80 border-slate-200/80';
        footer.className = 'border-t border-slate-200 bg-white py-6 text-xs';
        footerText.className = 'text-slate-500 flex items-center gap-2';
        
        brandLogo.className = 'w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center text-white shadow-md shadow-emerald-500/20';
        brandTitle.className = 'font-display font-bold text-lg tracking-tight block leading-tight text-slate-900';
        brandSubtitle.className = 'text-xs text-slate-500 font-medium';

        btnViewConsumer.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white text-slate-900 shadow-sm';
        btnViewAdmin.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-600 hover:text-slate-900';
      } else {
        consumerEl.classList.add('hidden');
        adminEl.classList.remove('hidden');

        body.className = 'bg-obsidian-base text-slate-100 transition-colors duration-300 min-h-screen flex flex-col';
        header.className = 'sticky top-0 z-50 backdrop-blur-md border-b bg-obsidian-surface/90 border-obsidian-border';
        footer.className = 'border-t border-obsidian-border bg-obsidian-surface py-6 text-xs text-slate-400';
        footerText.className = 'text-slate-400 flex items-center gap-2 font-mono';
        
        brandLogo.className = 'w-10 h-10 rounded-xl bg-obsidian-elevated border border-teal-500/30 flex items-center justify-center text-teal-400 shadow-md shadow-teal-500/10';
        brandTitle.className = 'font-mono font-bold text-lg tracking-tight block leading-tight text-white';
        brandSubtitle.className = 'text-xs text-teal-400 font-mono';

        btnViewConsumer.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-400 hover:text-white';
        btnViewAdmin.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-teal-500 text-obsidian-base shadow-sm font-mono';
        
        if (!adminChart) {
          initAdminChart();
        }
      }
    }

    // Zone Selector
    function selectZone(zone) {
      currentZone = zone;
      const b1 = document.getElementById('btnZone1');
      const b2 = document.getElementById('btnZone2');
      if (zone === 'uno-q-1') {
        b1.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all bg-white text-slate-900 shadow-sm';
        b2.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all';
        document.getElementById('consumerOccupancyVal').innerText = '8';
        document.getElementById('consumerCo2Val').innerText = '680';
      } else {
        b2.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all bg-white text-slate-900 shadow-sm';
        b1.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all';
        document.getElementById('consumerOccupancyVal').innerText = '4';
        document.getElementById('consumerCo2Val').innerText = '540';
      }
    }

    // Admin Real-time Slider Calculations
    let mockIngestTimer = null;

    function resetIngestTimer(intervalMs) {
      if (mockIngestTimer) clearInterval(mockIngestTimer);
      mockIngestTimer = setInterval(simulateIngest, Math.max(400, intervalMs));
    }

    function setArduinoInterval(val) {
      const slider = document.getElementById('sliderInterval');
      if (slider) {
        slider.value = val;
        updateAdminParams();
      }
    }

    function updateAdminParams() {
      const thresh = document.getElementById('sliderThreshold').value;
      const win = document.getElementById('sliderWindow').value;
      const factor = document.getElementById('sliderFactor').value;
      const interval = document.getElementById('sliderInterval') ? document.getElementById('sliderInterval').value : '5.0';

      document.getElementById('valThreshold').innerText = thresh + ' dBm';
      document.getElementById('valWindow').innerText = win + ' s';
      document.getElementById('valFactor').innerText = parseFloat(factor).toFixed(2);
      
      const valIntervalEl = document.getElementById('valInterval');
      if (valIntervalEl) valIntervalEl.innerText = parseFloat(interval).toFixed(1) + ' s';

      const note = document.getElementById('adminPostIntervalNote');
      if (note) note.innerText = parseFloat(interval).toFixed(1) + 's';

      const hdrInterval = document.getElementById('adminHeaderInterval');
      if (hdrInterval) hdrInterval.innerText = parseFloat(interval).toFixed(1) + 's';

      const node1Badge = document.getElementById('node1IntervalBadge');
      if (node1Badge) node1Badge.innerText = parseFloat(interval).toFixed(1) + 's interval';

      // Update mock ingest rate in real time to match the Arduino interval
      resetIngestTimer(parseFloat(interval) * 1000);

      // Recalculate estimated humans dynamically
      const inRangeCount = Math.max(5, Math.round(41 * (1 + (parseInt(thresh) + 75) / 50)));
      const humans = Math.round(inRangeCount * parseFloat(factor));
      
      document.getElementById('adminInRange').innerText = inRangeCount;
      document.getElementById('adminEstHumans').innerText = humans;
      document.getElementById('calcPreview').innerText = `${inRangeCount} × ${parseFloat(factor).toFixed(2)} = ${humans} people`;
    }

    function deployConfig() {
      configVersion++;
      const interval = document.getElementById('sliderInterval') ? parseFloat(document.getElementById('sliderInterval').value).toFixed(1) : '5.0';
      const thresh = document.getElementById('sliderThreshold').value;
      const win = document.getElementById('sliderWindow').value;
      const factor = parseFloat(document.getElementById('sliderFactor').value).toFixed(2);

      document.getElementById('configVerBadge').innerText = configVersion;
      alert(`Config v${configVersion} updated & queued!\n\nPayload sent to Arduino UNO Q (uno-q-1):\n• BLE Ingest/Send Interval: ${interval}s\n• RSSI Cutoff: ${thresh} dBm\n• Sliding Window: ${win}s\n• People Factor: ${factor}\n\nArduino board will adopt the ${interval}s interval on next HTTP 201 response.`);
    }

    function simulateIngest() {
      const stream = document.getElementById('deviceStream');
      const randomId = Math.random().toString(16).substring(2, 10) + Math.random().toString(16).substring(2, 10);
      const rssi = -(Math.floor(Math.random() * 40) + 50).toFixed(1);
      
      const newRow = document.createElement('div');
      newRow.className = 'flex items-center justify-between p-2 rounded bg-teal-950/40 border border-teal-500/30 transition-all animate-pulse';
      newRow.innerHTML = `
        <span class="text-teal-300 font-bold">${randomId}</span>
        <span class="text-teal-400">${rssi} dBm</span>
        <span class="text-slate-400 text-[10px]">live</span>
      `;
      stream.insertBefore(newRow, stream.firstChild);
      if (stream.children.length > 6) {
        stream.removeChild(stream.lastChild);
      }
    }

    // Chart 1: Consumer "Best Time to Visit" Forecast Chart
    function initConsumerChart() {
      const ctx = document.getElementById('consumerForecastChart').getContext('2d');
      const hours = ['08:00', '10:00', '12:00', '14:00', '16:00', '18:00', '20:00', '22:00'];
      const occupancy = [4, 7, 19, 9, 8, 14, 8, 3];

      consumerChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: hours,
          datasets: [{
            label: 'Predicted Occupancy (People)',
            data: occupancy,
            borderColor: '#22C55E',
            backgroundColor: 'rgba(34, 197, 94, 0.12)',
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#16A34A',
            pointRadius: 5,
            pointHoverRadius: 7,
            borderWidth: 3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#0F172A',
              titleFont: { family: 'General Sans', weight: 'bold' },
              bodyFont: { family: 'General Sans' },
              padding: 10,
              cornerRadius: 8,
              callbacks: {
                label: (ctx) => `Est. Occupancy: ${ctx.raw} people`
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              max: 25,
              grid: { color: 'rgba(226, 232, 240, 0.6)' },
              ticks: { font: { family: 'General Sans' }, color: '#64748B' }
            },
            x: {
              grid: { display: false },
              ticks: { font: { family: 'General Sans' }, color: '#64748B' }
            }
          }
        }
      });
    }

    // Chart 2: Admin Telemetry & Monte Carlo Fan Chart
    function initAdminChart() {
      const ctx = document.getElementById('adminTelemetryChart').getContext('2d');
      const times = ['18:00', '18:15', '18:30', '18:45', '19:00', '19:15', '19:30', '19:45'];

      adminChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: times,
          datasets: [
            {
              label: 'CO₂ Trajectory (Forecast)',
              data: [680, 790, 920, 1080, 1250, 1140, 890, 710],
              borderColor: '#2DD4BF',
              borderWidth: 2,
              tension: 0.3,
              pointRadius: 3,
              pointBackgroundColor: '#2DD4BF'
            },
            {
              label: 'Monte Carlo 95% Confidence Upper',
              data: [680, 830, 980, 1190, 1380, 1280, 980, 790],
              borderColor: 'rgba(45, 212, 191, 0.25)',
              borderDash: [4, 4],
              borderWidth: 1.5,
              fill: '+1',
              backgroundColor: 'rgba(45, 212, 191, 0.08)',
              pointRadius: 0
            },
            {
              label: 'Monte Carlo 95% Confidence Lower',
              data: [680, 750, 860, 970, 1120, 1000, 800, 650],
              borderColor: 'rgba(45, 212, 191, 0.25)',
              borderDash: [4, 4],
              borderWidth: 1.5,
              fill: false,
              pointRadius: 0
            },
            {
              label: 'Ventilation Threshold (1000 ppm)',
              data: [1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000],
              borderColor: '#F87171',
              borderWidth: 1.5,
              borderDash: [6, 6],
              fill: false,
              pointRadius: 0
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              labels: {
                color: '#94A3B8',
                font: { family: 'JetBrains Mono', size: 10 }
              }
            }
          },
          scales: {
            y: {
              min: 500,
              max: 1500,
              grid: { color: '#22262F' },
              ticks: { color: '#64748B', font: { family: 'JetBrains Mono' } }
            },
            x: {
              grid: { color: '#171A20' },
              ticks: { color: '#64748B', font: { family: 'JetBrains Mono' } }
            }
          }
        }
      });
    }

    window.addEventListener('DOMContentLoaded', () => {
      initConsumerChart();
      resetIngestTimer(5000);
    });
  </script>
</body>
