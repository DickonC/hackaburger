  <!-- ========================================== -->
  <footer class="border-t py-6 transition-colors duration-300 text-xs" id="mainFooter">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-slate-500 flex items-center gap-2" id="footerText">
        <span>Hackaburger Project // ETH Zürich Hackathon 2026</span>
        <span>•</span>
        <span>BLE Occupancy &amp; Cognitive Air Modeling</span>
      </div>
      <div class="flex items-center gap-4 text-slate-500">
        <a href="https://github.com/DickonC/hackaburger" target="_blank" class="hover:text-slate-900 transition-colors flex items-center gap-1">
          <i class="ph ph-github-logo"></i> GitHub
        </a>
        <a href="https://app.notion.com/p/le123654/Webdev-Tools-320882c3222380bb96afc935e277f5eb" target="_blank" class="hover:text-slate-900 transition-colors flex items-center gap-1">
          <i class="ph ph-bookmark-simple"></i> Webdev Inspo
        </a>
      </div>
    </div>
