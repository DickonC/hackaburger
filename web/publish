#!/usr/bin/env bash
# Copy the frontend files into web/public, which the hackaburger-web container serves.
# Only the files listed here are published, never the rest of the repo.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
FILES=(index.html admin.html backend.js)
mkdir -p public/js
for f in "${FILES[@]}"; do
  cp "../$f" "public/.$f.tmp" && mv "public/.$f.tmp" "public/$f"
done
cp "../js/engine.js" "public/js/.engine.js.tmp" && mv "public/js/.engine.js.tmp" "public/js/engine.js"
echo "Published: ${FILES[*]} js/engine.js"
